---
<header class="main-header">
  <div class="container_p header-flex">
    <div class="header-logo">
      NIEVES PÉREZ ALONSO
    </div>
    <nav>
      <ul class="nav-links">
        <li><a href="#inicio">INICIO</a></li>
        <li><a href="#proyectos">PROYECTOS</a></li>
        <li><a href="#skills">SKILLS</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .main-header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 100;
    background: rgba(2, 5, 2, 0.9);
    border-bottom: 1px solid rgba(35, 54, 41, 0.3);
    backdrop-filter: blur(10px);
  }

  .header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
  }

  .header-logo {
    font-family: 'Inconsolata', monospace;
    letter-spacing: 2px;
    font-weight: 700;
    color: #ffffff;
    font-size: 0.9rem;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: #d1d1d1;
    font-size: 0.75rem;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .header-logo {
      font-size: 0.7rem;
    }
    .nav-links {
      gap: 15px;
    }
  }
</style>
