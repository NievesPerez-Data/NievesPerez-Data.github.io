---
const tech = ["Python", "SQL", "Tableau", "Power BI", "Git"];
const biz = ["Análisis de KPIs", "Estrategia Retail", "Scrum"];
---
<section id="skills" style="padding: 60px 20px; max-width: 1100px; margin: 0 auto;">
  <h2 style="color: #01be96; margin-bottom: 30px;">Habilidades</h2>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
    <div>
      <h3 style="color: #fff; margin-bottom: 15px;">Technology</h3>
      <ul style="list-style: none; color: #888;">
        {tech.map(s => <li style="margin-bottom: 8px;">▹ {s}</li>)}
      </ul>
    </div>
    <div>
      <h3 style="color: #fff; margin-bottom: 15px;">Business</h3>
      <ul style="list-style: none; color: #888;">
        {biz.map(s => <li style="margin-bottom: 8px;">▹ {s}</li>)}
      </ul>
    </div>
  </div>
</section>
