---
/* Datos de Nieves */
const tech = ["Python", "SQL", "Tableau", "Power BI", "Git"];
const biz = ["KPIs Retail", "Estrategia Comercial", "Gestión Operativa"];
---
<section class="skills" id="skills">
  <div class="container_p">
    <h2 style="color: #01be96; font-size: 2rem; padding: 20px 0;">Habilidades</h2>
    <div style="display: flex; gap: 50px; flex-wrap: wrap;">
      <div>
        <h3 style="color: #fff; margin-bottom: 15px;">Data & Tech</h3>
        <ul style="list-style: none; color: #888;">
          {tech.map(item => <li style="margin-bottom: 10px;">▹ {item}</li>)}
        </ul>
      </div>
      <div>
        <h3 style="color: #fff; margin-bottom: 15px;">Business</h3>
        <ul style="list-style: none; color: #888;">
          {biz.map(item => <li style="margin-bottom: 10px;">▹ {item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
