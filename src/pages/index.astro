---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// Configuración de GitHub
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  // Pedimos los 30 repositorios más recientes
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=30`);
  
  if (response.ok) {
    const data = await response.json();
    
    // REPOS EXACTOS A OCULTAR
    const reposAOcultar = [
      "nievesperez-data",            // README de perfil
      "nievesperez-data.github.io",  // El repositorio del Portfolio
    ];
    
    proyectos = data
      .filter(repo => !reposAOcultar.includes(repo.name.toLowerCase()))
      .map(repo => {
        // Extraemos la descripción base
        const baseDesc = repo.description || "Sin descripción disponible.";
        
        // Si tienes puesto un enlace en la sección "Website" de GitHub, lo añadimos
        const webLink = repo.homepage ? ` | 🔗 Ver proyecto: ${repo.homepage}` : "";

        return {
          name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
          url: repo.html_url,
          desc: baseDesc + webLink, // Combinamos ambos
          lang: repo.language || "Astro"
        };
      });
  } else {
    throw new Error("No se pudieron cargar los repositorios");
  }
} catch (e) {
  error = "Hubo un problema conectando con GitHub.";
  proyectos = [
    { 
      name: "Sakila Cinema Analytics", 
      url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
      desc: "Análisis de bases de datos SQL para optimizar inventario y comportamiento de clientes.", 
      lang: "SQL" 
    }
  ];
}
