---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// Configuración de GitHub
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  
  if (response.ok) {
    const data = await response.json();
    const reposAOcultar = [`${GITHUB_USERNAME.toLowerCase()}.github.io`, "portfolio-astro"];
    
    proyectos = data
      .filter(repo => !reposAOcultar.includes(repo.name.toLowerCase()))
      .slice(0, 6) 
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Sin descripción disponible en el repositorio.",
        lang: repo.language || "Markdown"
      }));
  } else {
    throw new Error("No se pudieron cargar los repositorios");
  }
} catch (e) {
  error = "Hubo un problema conectando con GitHub.";
  proyectos = [
    { 
      name: "Sakila Cinema Analytics", 
      url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
      desc: "Análisis de bases de datos SQL para optimizar inventario y comportamiento de clientes.", 
      lang: "SQL" 
    }
  ];
}

// Habilidades con iconos unificados
const habilidades = [
  { nombre: "Python", icon: "fa-brands fa-python" },
  { nombre: "Pandas", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pandas/pandas-original.svg" },
  { nombre: "NumPy", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/numpy/numpy-original.svg" },
  { nombre: "MySQL", logo: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" },
  { nombre: "Tableau", icon: "fa-solid fa-chart-pie" },
  { nombre: "Power BI", icon: "fa-solid fa-chart-column" },
  { nombre: "Web Scraping", icon: "fa-solid fa-spider" },
  { nombre: "Git", icon: "fa-brands fa-git-alt" },
  { nombre: "GitHub", icon: "fa-brands fa-github" },
  { nombre: "Excel", icon: "fa-regular fa-file-excel" },
  { nombre: "Ollama IA", icon: "fa-solid fa-robot" } 
];
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analyst</title>
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>
<body style="background-color: #020502; color: #ffffff; margin: 0; font-family: 'Lato', sans-serif;">
  <Header />

  <main style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- INICIO -->
    <section id="inicio" style="display: flex; align-items: center; justify-content: space-between; padding: 160px 0 80px 0; min-height: 80vh; flex-wrap: wrap; gap: 40px;">
      <div style="flex: 2; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.4rem; font-weight: 700; margin-bottom: 10px;">Nieves Pérez Alonso</p>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin: 0 0 25px 0; font-weight: 800; text-transform: uppercase;">DATA ANALYST <br/> RETAIL SPECIALIST</h1>
        
        <p style="color: #d1d1d1; line-height: 1.6; margin-bottom: 40px; max-width: 580px; font-size: 1.1rem;">
          Especializada en transformar datos complejos en decisiones estratégicas con un fuerte background en gestión operativa de Retail.
        </p>

        <div id="contacto" style="display: flex; gap: 20px; margin-bottom: 40px;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; border: 2px solid #0f705d;">Hablemos</a>
          <a href="#" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px;">Currículum</a>
        </div>

        <div style="display: flex; align-items: center; gap: 15px;">
          <span style="font-size: 0.95rem; opacity: 0.8;">Mis redes:</span>
          <div style="display: flex; gap: 10px;">
            <a href={`https://github.com/${GITHUB_USERNAME}`} style="color: #ffffff; font-size: 1.5rem;"><i class="fa-brands fa-github"></i></a>
            <a href="https://linkedin.com/in/nievesperezalonso" style="color: #ffffff; font-size: 1.5rem;"><i class="fa-brands fa-linkedin"></i></a>
          </div>
        </div>
      </div>
      
      <div style="flex: 1; display: flex; justify-content: center;">
        <div style="width: 300px; height: 300px; border-radius: 50%; overflow: hidden; border: 2px solid #0f705d; background: #111; position: relative;">
          <!-- Espacio para tu imagen -->
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle, rgba(15, 112, 93, 0.2) 0%, transparent 70%);"></div>
          <img src="/img/tu-foto.webp" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover; z-index: 1;" onerror="this.style.opacity='0'"/>
        </div>
      </div>
    </section>

    <!-- HABILIDADES (FILTRADO VERDE UNIFICADO) -->
    <section id="habilidades" style="padding: 80px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.8rem; text-transform: uppercase; margin-bottom: 50px; border-bottom: 1px solid rgba(15, 112, 93, 0.3); padding-bottom: 10px; display: inline-block;">Habilidades</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 40px; margin-top: 20px;">
        {habilidades.map(hab => (
          <div class="skill-card" style="display: flex; flex-direction: column; align-items: center; gap: 12px; cursor: default;">
            <div class="icon-container" style="width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; background: rgba(15, 112, 93, 0.05); border-radius: 12px; transition: 0.3s; border: 1px solid rgba(15, 112, 93, 0.1);">
              {hab.logo ? (
                <img src={hab.logo} alt={hab.nombre} class="green-filter" style="width: 35px; height: 35px; object-fit: contain;" />
              ) : (
                <i class={`${hab.icon}`} style="font-size: 2rem; color: #0f705d;"></i>
              )}
            </div>
            <span style="font-size: 0.85rem; color: #999; font-weight: 500; text-align: center; font-family: 'Inconsolata', monospace;">{hab.nombre}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- PROYECTOS -->
    <section id="proyectos" style="padding: 80px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.8rem; text-transform: uppercase; margin-bottom: 40px;">Proyectos Destacados</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 25px;">
        {proyectos.map(p => (
          <div style="background: #0a0a0a; border: 1px solid #1a1a1a; padding: 25px; border-radius: 8px; transition: 0.3s;" class="project-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
              <i class="fa-regular fa-folder" style="font-size: 2rem; color: #0f705d;"></i>
              <a href={p.url} target="_blank" style="color: #fff; opacity: 0.5;"><i class="fa-brands fa-github"></i></a>
            </div>
            <h3 style="margin: 0 0 10px 0; font-size: 1.3rem; color: #ffffff;">{p.name}</h3>
            <p style="color: #888; font-size: 0.95rem; line-height: 1.5; height: 60px; overflow: hidden; text-align: justify;">{p.desc}</p>
            <div style="margin-top: 20px; font-family: 'Inconsolata', monospace; color: #0f705d; font-size: 0.8rem;">
              <span># {p.lang}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ESTUDIOS -->
    <section id="estudios" style="padding: 80px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.8rem; text-transform: uppercase; margin-bottom: 40px;">Formación</h2>
      <div style="display: flex; flex-direction: column; gap: 30px;">
        <div style="background: linear-gradient(90deg, #0f705d1a 0%, transparent 100%); padding: 25px; border-left: 4px solid #0f705d;">
          <h3 style="margin: 0; color: #fff; font-size: 1.2rem;">ADALAB</h3>
          <p style="margin: 5px 0; color: #0f705d; font-weight: bold;">Bootcamp Data Analytics & IA</p>
          <span style="color: #666; font-size: 0.9rem;">2025 - 2026</span>
        </div>
        <div style="padding: 25px; border-left: 4px solid #1a1a1a;">
          <h3 style="margin: 0; color: #fff; font-size: 1.2rem;">UNIV. COMPLUTENSE DE MADRID</h3>
          <p style="margin: 5px 0; color: #ccc;">Máster en Educación Artística</p>
          <span style="color: #666; font-size: 0.9rem;">2014 - 2015</span>
        </div>
      </div>
    </section>

  </main>

  <Footer />

  <style>
    /* Efecto unificado para imágenes: Las convierte a tonos verdes */
    .green-filter {
      filter: invert(33%) sepia(80%) saturate(450%) hue-rotate(125deg) brightness(95%) contrast(90%);
      transition: 0.3s;
    }

    .skill-card:hover .icon-container {
      background: rgba(15, 112, 93, 0.15);
      border-color: #0f705d;
      transform: translateY(-5px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }
    
    .skill-card:hover .green-filter {
      filter: invert(33%) sepia(80%) saturate(600%) hue-rotate(125deg) brightness(110%) contrast(100%);
    }

    .skill-card:hover span {
      color: #0f705d;
    }

    .project-card:hover {
      border-color: #0f705d;
      transform: translateY(-5px);
      background: rgba(15, 112, 93, 0.02);
    }
  </style>
</body>
</html>
