          { name: "Python", icon: "devicon-python-plain" },
          { name: "MySQL", icon: "devicon-mysql-plain" },
          { name: "Pandas", icon: "devicon-pandas-plain" },
          { name: "Tableau", icon: "fa-solid fa-chart-pie" },
          { name: "Power BI", icon: "fa-solid fa-chart-column" },
          { name: "Ollama IA", icon: "fa-solid fa-brain" },
          { name: "Scraping", icon: "fa-solid fa-spider" },
          { name: "Excel", icon: "fa-regular fa-file-excel" },
          { name: "Git/GitHub", icon: "devicon-git-plain" }
        ].map(skill => (
          <div style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.1); padding: 25px; border-radius: 8px; text-align: center; transition: 0.3s;">
             <i class={skill.icon} style="font-size: 2rem; color: #0f705d; display: block; margin-bottom: 10px;"></i>
             <span class="typewriter-font" style="font-size: 0.85rem; font-weight: 700; color: #ffffff;">{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN FORMACIÓN (TÍTULO SIMPLIFICADO) -->
    <section id="estudios" style="padding: 100px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px; display: flex; align-items: center; gap: 15px;">
        Formación <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      
      <div style="display: flex; flex-direction: column; gap: 40px;">
        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 class="typewriter-font" style="margin: 0; font-size: 1.25rem; color: #ffffff;">DATA ANALYST</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Análisis de Datos & Inteligencia Artificial aplicada</p>
          <div style="color: #888888; font-size: 0.9rem; font-family: 'Inconsolata', monospace;">2024 - Actualidad</div>
        </div>

        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 class="typewriter-font" style="margin: 0; font-size: 1.25rem; color: #ffffff;">MÁSTER EN EDUCACIÓN ARTÍSTICA</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Especialización en Instituciones Sociales y Culturales</p>
          <div style="color: #888888; font-size: 0.9rem; font-family: 'Inconsolata', monospace;">Madrid | 2014-2015</div>
        </div>

        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 class="typewriter-font" style="margin: 0; font-size: 1.25rem; color: #ffffff;">GRADO EN HISTORIA DEL ARTE</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Facultad de Filosofía y Letras</p>
          <div style="color: #888888; font-size: 0.9rem; font-family: 'Inconsolata', monospace;">Madrid | 2009-2014</div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN SOBRE MÍ ORIGINAL -->
    <section id="sobremi" style="padding: 100px 0 150px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px; display: flex; align-items: center; gap: 15px;">
        Sobre mí <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      <div class="text-justified" style="color: #aaaaaa; max-width: 850px; line-height: 1.8; font-size: 1.1rem;">
        <p style="margin-bottom: 20px;">
          Mi trayectoria profesional se ha centrado en la intersección entre la estrategia de negocio y la eficiencia operativa. Con más de 6 años de experiencia en entornos dinámicos, he desarrollado una capacidad analítica centrada en la resolución de problemas y la optimización de resultados.
        </p>
        <p>
          Actualmente, enfoco mi carrera en el análisis de datos para transformar métricas en historias accionables. Mi objetivo es utilizar herramientas técnicas avanzadas para proporcionar una visión clara que facilite el crecimiento y la toma de decisiones basada en datos.
