---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css"; // Importación vital

const proyectos = [
  { name: "Sakila Cinema Analytics", url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", desc: "SQL & Data Analysis para optimizar inventario.", lang: "SQL" },
  { name: "The Friends Data Project", url: "https://github.com/NievesPerezData/proyecto_serieTV_Friends_Tableau", desc: "NLP y Sentiment Analysis sobre guiones.", lang: "Tableau" },
  { name: "Análisis Retail Oysho", url: "#", desc: "Optimización de KPIs y gestión de stock.", lang: "Excel/BI" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nieves Pérez Alonso | Data Analyst</title>
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <Header />
    
    <main class="container_p">
      <section id="inicio" style="text-align: center; padding-top: 120px;">
        <div style="width: 180px; height: 180px; border-radius: 50%; border: 3px solid #4ade80; margin: 0 auto 20px; overflow: hidden;">
          <img src="/img/tu-foto.webp" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <h1 style="font-size: 3rem; margin: 10px 0;">Nieves Pérez Alonso</h1>
        <p style="color: #4ade80; font-weight: bold; font-size: 1.2rem;">Data Analyst | Retail Expert</p>
      </section>

      <section id="proyectos">
        <h2>Proyectos</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
          {proyectos.map(p => (
            <div style="background: #0a0f0a; border: 1px solid #1a2e1a; padding: 25px; border-radius: 12px;">
              <h3 style="color: #fff; margin-bottom: 10px;">{p.name}</h3>
              <p style="color: #888; font-size: 0.9rem;">{p.desc}</p>
              <span style="color: #4ade80; font-weight: bold;">{p.lang}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="skills">
        <h2>Habilidades</h2>
        <div style="display: flex; gap: 40px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 250px;">
            <h4 style="color: #fff;">Tech & Data</h4>
            <ul style="color: #aaa; list-style: none; padding: 0;">
              <li>▹ Python</li><li>▹ SQL</li><li>▹ Tableau</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="estudios">
        <h2>Estudios</h2>
        <div style="border-left: 2px solid #4ade80; padding-left: 20px;">
          <h3 style="color: #fff;">Bootcamp Data Analytics</h3>
          <p style="color: #888;">Adalab | 2024 - 2025</p>
        </div>
      </section>

      <section id="sobremi">
        <h2>Sobre mí</h2>
        <p style="color: #aaa; line-height: 1.8;">
          Store Manager con más de 6 años de experiencia en Oysho (Inditex). Especializada en análisis de KPIs y gestión de operaciones.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>
