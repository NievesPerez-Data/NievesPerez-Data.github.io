---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";

// 1. CONFIGURACIÓN DE TU USUARIO DE GITHUB
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  
  if (response.ok) {
    const data = await response.json();
    proyectos = data
      .filter(repo => !repo.name.includes('github.io'))
      .slice(0, 6)
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Proyecto de análisis de datos y estrategia.",
        lang: repo.language || "Data"
      }));
  } else {
    throw new Error("No se pudo conectar con la API");
  }
} catch (e) {
  error = "No se pudieron cargar los proyectos de GitHub.";
  proyectos = [{ 
    name: "Sakila Cinema Analytics", 
    url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
    desc: "Análisis de bases de datos SQL para optimizar inventario.", 
    lang: "SQL" 
  }];
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analytics & Operations Strategy</title>
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous" is:inline></script>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      background-color: #020502;
      color: #ffffff;
      margin: 0;
      font-family: 'Lato', sans-serif;
      scroll-behavior: smooth;
    }
    .text-justified {
      text-align: justify;
      hyphens: auto;
    }
    .typewriter-font {
      font-family: 'Courier Prime', 'Courier New', Courier, monospace;
    }
    section {
      scroll-margin-top: 80px;
    }
    .project-card:hover {
      border-color: #0f705d !important;
      transform: translateY(-5px);
    }
    @media (max-width: 768px) {
      .hero-section {
        flex-direction: column-reverse !important;
        text-align: center;
        padding-top: 100px !important;
      }
      .photo-container {
        width: 250px !important;
        height: 250px !important;
      }
      .text-justified {
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <Header />

  <main style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- SECCIÓN INICIO -->
    <section id="inicio" class="hero-section" style="display: flex; align-items: center; justify-content: space-between; padding: 160px 0 80px 0; min-height: 80vh; gap: 40px;">
      <div style="flex: 1; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.8rem; font-weight: 700; margin-bottom: 10px;">Nieves Pérez Alonso</p>
        <h1 class="typewriter-font" style="font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.2; margin: 0 0 25px 0; font-weight: 800; text-transform: uppercase;">DATA ANALYTICS <br/> & OPERATIONS STRATEGY</h1>
        <p class="text-justified" style="color: #d1d1d1; line-height: 1.6; margin-bottom: 40px; max-width: 620px; font-size: 1.15rem;">
          Integrando analítica avanzada y visión estratégica para optimizar procesos y detectar oportunidades de crecimiento para la toma de decisiones de alto impacto.
        </p>
        <div style="display: flex; gap: 20px; margin-bottom: 40px; flex-wrap: wrap;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; border: 2px solid #0f705d;">Hablemos</a>
          <a href="/cv-nieves-perez.pdf" target="_blank" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px;">Currículum</a>
        </div>
        <div style="display: flex; align-items: center; gap: 20px;">
          <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" style="color: #0f705d; font-size: 1.8rem;"><i class="fa-brands fa-github"></i></a>
          <a href="https://linkedin.com/in/nievesperezalonso" target="_blank" style="color: #0f705d; font-size: 1.8rem;"><i class="fa-brands fa-linkedin"></i></a>
        </div>
      </div>
      <div class="photo-container" style="width: 350px; height: 350px; border-radius: 50%; border: 3px solid #0f705d; overflow: hidden; position: relative; box-shadow: 0 0 30px rgba(15, 112, 93, 0.4); flex-shrink: 0;">
        <img src="/img/tu-foto.webp" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://via.placeholder.com/350x350/020502/0f705d?text=NPA'"/>
      </div>
    </section>

    <!-- SECCIÓN PROYECTOS -->
    <section id="proyectos" style="padding: 100px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px; display: flex; align-items: center; gap: 15px;">
        Proyectos <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
        {proyectos.map(p => (
          <div class="project-card" style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.2); padding: 30px; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; transition: 0.3s;">
            <div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 20px; color: #0f705d;">
                <i class="fa-regular fa-folder" style="font-size: 1.5rem;"></i>
                <a href={p.url} target="_blank" style="color: #ffffff; opacity: 0.7;"><i class="fa-brands fa-github"></i></a>
              </div>
              <h3 class="typewriter-font" style="color: #ffffff; margin-bottom: 10px; text-transform: capitalize;">{p.name}</h3>
              <p class="text-justified" style="color: #aaaaaa; font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px;">{p.desc}</p>
            </div>
            <span style="color: #0f705d; font-family: 'Inconsolata', monospace; font-weight: bold; font-size: 0.8rem;">{p.lang}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN HABILIDADES -->
    <section id="habilidades" style="padding: 100px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px; display: flex; align-items: center; gap: 15px;">
        Habilidades <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 20px;">
        {[
          { name: "Python", icon: "fa-brands fa-python" },
          { name: "MySQL", icon: "fa-solid fa-database" },
          { name: "Pandas", icon: "fa-solid fa-table-list" },
          { name: "Tableau", icon: "fa-solid fa-chart-pie" },
          { name: "Power BI", icon: "fa-solid fa-chart-column" },
          { name: "Ollama IA", icon: "fa-solid fa-brain" },
          { name: "Scraping", icon: "fa-solid fa-spider" },
          { name: "Excel", icon: "fa-regular fa-file-excel" },
          { name: "Git/GitHub", icon: "fa-brands fa-github" }
        ].map(skill => (
          <div style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.1); padding: 25px; border-radius: 8px; text-align: center;">
             <i class={skill.icon} style="font-size: 2rem; color: #0f705d; display: block; margin-bottom: 10px;"></i>
             <span class="typewriter-font" style="font-size: 0.85rem; font-weight: 700; color: #ffffff;">{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN FORMACIÓN -->
    <section id="estudios" style="padding: 100px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px; display: flex; align-items: center; gap: 15px;">
        Formación <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      <div style="display: flex; flex-direction: column; gap: 40px;">
        <!-- ADALAB -->
        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 class="typewriter-font" style="margin: 0; font-size: 1.25rem; color: #ffffff;">ADALAB</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Bootcamp Data Analytics & Inteligencia Artificial aplicada</p>
          <div style="color: #888888; font-size: 0.9rem; font-family: 'Inconsolata', monospace;">Online | 2025-2026</div>
        </div>
        <!-- UCM -->
        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 class="typewriter-font" style="margin: 0; font-size: 1.25rem; color: #ffffff;">UNIVERSIDAD COMPLUTENSE DE MADRID</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Máster en Educación Artística en Instituciones Sociales y Culturales</p>
          <div style="color: #888888; font-size: 0.9rem; font-family: 'Inconsolata', monospace;">Madrid | 2014-2015</div>
        </div>
        <!-- UAM -->
        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 class="typewriter-font" style="margin: 0; font-size: 1.25rem; color: #ffffff;">UNIVERSIDAD AUTÓNOMA DE MADRID</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Grado en Historia del Arte</p>
          <div style="color: #888888; font-size: 0.9rem; font-family: 'Inconsolata', monospace;">Madrid | 2009-2014</div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN SOBRE MÍ -->
    <section id="sobremi" style="padding: 100px 0 150px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px; display: flex; align-items: center; gap: 15px;">
        Sobre mí <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      <div class="text-justified" style="color: #aaaaaa; max-width: 900px; line-height: 1.8; font-size: 1.1rem;">
        <p style="margin-bottom: 25px;">
          Mi trayectoria se ha centrado en la dirección estratégica y la optimización operativa, donde descubrí que el verdadero valor diferencial reside en la capacidad de transformar datos brutos en decisiones inteligentes. Combino una sólida experiencia en gestión de equipos y unidades de negocio con una formación técnica avanzada en Análisis de Datos, lo que me permite aportar una visión de negocio única junto a una capacidad real para traducir datasets complejos en KPIs de rendimiento que impactan directamente en el crecimiento.
        </p>
        <p style="margin-bottom: 25px;">
          Cuento con experiencia práctica en la exploración, limpieza y transformación de datos (ETL), asegurando siempre que la información sea precisa, útil y accionable para el diseño de estrategias comerciales. Mi enfoque no solo analiza el pasado, sino que utiliza la excelencia técnica para optimizar procesos operativos y detectar oportunidades de mercado mediante el análisis avanzado. 
        </p>
        <p>
          Mi valor reside en unir el rigor de la analítica con la visión ejecutiva necesaria para garantizar que cada dato se transforme en una decisión estratégica que aporte un valor real y medible al negocio.
        </p>
      </div>
    </section>

  </main>
  <Footer />
</body>
</html>
