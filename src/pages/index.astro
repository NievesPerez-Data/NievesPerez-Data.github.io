---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// Lista de tus 6 proyectos definida correctamente dentro del bloque de Astro
const proyectos = [
  { 
    name: "Sakila Cinema Analytics", 
    url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
    desc: "Análisis de bases de datos SQL para optimizar inventario y comportamiento de clientes.", 
    lang: "SQL" 
  },
  { 
    name: "The Friends Data Project", 
    url: "https://github.com/NievesPerezData/proyecto_serieTV_Friends_Tableau", 
    desc: "NLP y análisis de sentimiento aplicado a los guiones de la serie Friends.", 
    lang: "Tableau & Python" 
  },
  { 
    name: "Análisis Retail Oysho", 
    url: "#", 
    desc: "Optimización de KPIs, gestión de stock y análisis de ventas en tiempo real.", 
    lang: "Excel & BI" 
  },
  { 
    name: "Accidentes viales en Madrid", 
    url: "#", 
    desc: "Estudio estadístico sobre la siniestralidad vial utilizando Python.", 
    lang: "Python" 
  },
  { 
    name: "Diamond Price Predictor", 
    url: "#", 
    desc: "Modelo de Machine Learning para predecir el precio de diamantes.", 
    lang: "ML & Scikit-learn" 
  },
  { 
    name: "E-commerce Segmentation", 
    url: "#", 
    desc: "Segmentación de clientes mediante algoritmos de clustering (K-Means).", 
    lang: "Python" 
  }
];
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analyst</title>
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>
<body style="background-color: #020502; color: #ffffff; margin: 0; font-family: 'Lato', sans-serif;">
  <Header />

  <main style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- SECCIÓN INICIO / CONTACTO -->
    <section id="inicio" style="display: flex; align-items: center; justify-content: space-between; padding: 160px 0 80px 0; min-height: 80vh; flex-wrap: wrap; gap: 40px;">
      
      <div style="flex: 1; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.4rem; font-weight: 700; margin-bottom: 10px;">Nieves Pérez Alonso</p>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin: 0 0 25px 0; font-weight: 800; text-transform: uppercase;">DATA ANALYST <br/> RETAIL SPECIALIST</h1>
        
        <p style="color: #d1d1d1; line-height: 1.6; margin-bottom: 40px; max-width: 580px; font-size: 1.1rem;">
          Especializada en transformar datos complejos en decisiones estratégicas. 
          Con un fuerte background en gestión operativa de Retail y apasionada por la analítica de negocio.
        </p>

        <div id="contacto" style="display: flex; gap: 20px; margin-bottom: 40px; scroll-margin-top: 120px;">
          <a href="mailto:tu-email@ejemplo.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; border: 2px solid #0f705d; transition: 0.3s;">Hablemos</a>
          <a href="#" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; transition: 0.3s;">Ver Currículum</a>
        </div>

        <div style="display: flex; align-items: center; gap: 15px; color: #ffffff;">
          <span style="font-size: 0.95rem;">Echa un vistazo a mi</span>
          <div style="display: flex; gap: 10px;">
            <a href="https://github.com/tu-perfil" style="background: #0f705d; color: #ffffff; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 4px; text-decoration: none;"><i class="fa-brands fa-github"></i></a>
            <a href="https://linkedin.com/in/tu-perfil" style="background: #0f705d; color: #ffffff; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 4px; text-decoration: none;"><i class="fa-brands fa-linkedin"></i></a>
          </div>
        </div>
      </div>
      
      <div style="position: relative; width: 350px; height: 350px; display: flex; align-items: center; justify-content: center;">
        <div style="position: absolute; width: 120%; height: 120%; background: radial-gradient(circle, rgba(15, 112, 93, 0.25) 0%, transparent 70%); border-radius: 50%;"></div>
        <div style="position: relative; width: 300px; height: 300px; border-radius: 50%; overflow: hidden; border: 1px solid rgba(15, 112, 93, 0.3); background: #0a0a0a; z-index: 2;">
          <img src="/img/tu-foto.webp" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.opacity='0'"/>
        </div>
      </div>
    </section>

    <!-- SECCIÓN PROYECTOS -->
    <section id="proyectos" style="padding: 100px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px;">// Proyectos</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
        {proyectos.map(p => (
          <div style="background: rgba(15, 112, 93, 0.03); border: 1px solid rgba(15, 112, 93, 0.1); padding: 30px; border-radius: 4px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 25px; color: #0f705d;">
              <i class="fa-regular fa-folder" style="font-size: 1.8rem;"></i>
              <a href={p.url} style="color: #ffffff; opacity: 0.6;"><i class="fa-brands fa-github" style="font-size: 1.3rem;"></i></a>
            </div>
            <h3 style="margin: 0 0 12px 0; font-size: 1.2rem; color: #ffffff;">{p.name}</h3>
            <p style="color: #aaaaaa; font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px;">{p.desc}</p>
            <div style="color: #0f705d; font-size: 0.8rem; font-weight: 700; font-family: 'Inconsolata', monospace;">
              &lt; {p.lang} /&gt;
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN HABILIDADES -->
    <section id="habilidades" style="padding: 100px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px;">// Habilidades</h2>
      <div style="border: 1px solid rgba(15, 112, 93, 0.2); padding: 40px; background: rgba(15, 112, 93, 0.03); border-radius: 4px;">
         <p style="color: #cccccc; line-height: 2; font-size: 1.1rem; margin: 0;">
           Python • SQL • Tableau • Power BI • Análisis de KPIs • Estrategia de Retail • Git • GitHub
         </p>
      </div>
    </section>

    <!-- SECCIÓN ESTUDIOS -->
    <section id="estudios" style="padding: 100px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px;">// Estudios</h2>
      <div style="border-left: 3px solid #0f705d; padding-left: 25px; margin-bottom: 30px;">
        <h3 style="margin: 0; font-size: 1.2rem;">Bootcamp Data Analytics</h3>
        <p style="color: #888888; margin: 8px 0 0 0;">Ironhack | 2023</p>
      </div>
    </section>

    <!-- SECCIÓN SOBRE MÍ -->
    <section id="sobremi" style="padding: 100px 0 150px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px;">// Sobre mí</h2>
      <p style="color: #aaaaaa; max-width: 850px; line-height: 1.8; font-size: 1.1rem; margin: 0;">
        Tras años liderando operaciones en el sector Retail, mi transición al análisis de datos responde a una pasión por optimizar procesos mediante el dato.
      </p>
    </section>

  </main>

  <Footer />
</body>
</html>
