---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// Configuración de GitHub
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  
  if (response.ok) {
    const data = await response.json();
    
    const reposAOcultar = [`${GITHUB_USERNAME.toLowerCase()}.github.io`, "portfolio-astro"];
    
    proyectos = data
      .filter(repo => !reposAOcultar.includes(repo.name.toLowerCase()))
      .slice(0, 6)
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Sin descripción disponible en el repositorio.",
        lang: repo.language || "Markdown"
      }));
  } else {
    throw new Error("No se pudieron cargar los repositorios");
  }
} catch (e) {
  error = "Hubo un problema conectando con GitHub.";
  proyectos = [
    { 
      name: "Sakila Cinema Analytics", 
      url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
      desc: "Análisis de bases de datos SQL para optimizar inventario y comportamiento de clientes.", 
      lang: "SQL" 
    }
  ];
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analyst</title>
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>

<body style="background-color: #020502; color: #ffffff; margin: 0; font-family: 'Lato', sans-serif;">
  <Header />

  <main style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- SECCIÓN INICIO -->
    <section id="inicio" style="display: flex; align-items: center; justify-content: space-between; padding: 160px 0 80px 0; min-height: 80vh; flex-wrap: wrap; gap: 40px;">
      
      <div style="flex: 1; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.4rem; font-weight: 700;">Nieves Pérez Alonso</p>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; text-transform: uppercase;">Data Analytics & <br/> Operations Strategy</h1>
        <p style="color: #d1d1d1; max-width: 580px; line-height: 1.6;">
          Integrando analítica avanzada y visión estratégica para optimizar procesos y detectar oportunidades de crecimiento para la toma de decisiones de alto impacto.
        </p>

        <div style="display: flex; gap: 20px; margin: 30px 0;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700;">Hablemos</a>
          <a href="#" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700;">Ver Currículum</a>
        </div>
      </div>

      <!-- FOTO -->
      <div style="position: relative; width: 350px; height: 350px; display: flex; align-items: center; justify-content: center;">
        <div style="position: absolute; width: 120%; height: 120%; background: radial-gradient(circle, rgba(15,112,93,0.25) 0%, transparent 70%); border-radius: 50%;"></div>
        <div style="position: relative; width: 300px; height: 300px; border-radius: 50%; overflow: hidden; border: 1px solid rgba(15,112,93,0.3);">
          <img src="/img/profile.jpg" alt="Nieves Pérez" style="width:100%; height:100%; object-fit:cover;" />
        </div>
      </div>
    </section>

    <!-- PROYECTOS -->
    <section id="proyectos" style="padding:100px 0;">
      <h2>Proyectos</h2>
      <div>
        {proyectos.map(p => (
          <div>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ESTUDIOS -->
    <section id="estudios" style="padding:100px 0;">
      <h2>Estudios</h2>
      <p><strong>ADALAB</strong> — Bootcamp Data Analytics & IA (2025-2026)</p>
      <p><strong>UCM</strong> — Máster Educación Artística (2014-2015)</p>
      <p><strong>UAM</strong> — Grado Historia del Arte (2009-2014)</p>
    </section>

    <!-- SOBRE MI -->
    <section id="sobremi" style="padding:100px 0;">
      <h2>Sobre mí</h2>
      <p>
        Mi trayectoria se ha centrado en la dirección estratégica y la optimización operativa, donde descubrí que el verdadero valor diferencial reside en la capacidad de transformar datos brutos en decisiones inteligentes.
      </p>
      <p>
        Combino experiencia en gestión con formación técnica en análisis de datos, permitiéndome traducir datasets complejos en KPIs accionables.
      </p>
    </section>

  </main>

  <Footer />
</body>
</html>
