---
import Header from "../components/header/Header.astro";
import Main from "../components/main/main.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Nieves Pérez Alonso | Data Analyst</title>
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <Header />
    <Main />
    <Footer />
  </body>
</html>

<style is:global>
  /* ESTO FUERZA EL COLOR NEGRO EN TODA LA WEB */
  :root {
    --primary-color: #01be96;
    --background-color: #000;
  }

  html, body {
    background-color: #000 !important; /* El !important es para que nada lo cambie a blanco */
    color: #f6f6f9 !important;
    margin: 0;
    padding: 0;
    font-family: 'ABeeZee', sans-serif;
    scroll-behavior: smooth;
  }

  /* Esto hace que cuando pulses "Habilidades", el título no quede tapado por el menú */
  section {
    scroll-margin-top: 100px;
    background-color: #000;
  }

  .container_p {
    max-width: 1355px;
    margin: 0 auto;
    background-color: #000;
  }
</style>
