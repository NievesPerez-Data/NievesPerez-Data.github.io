---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";

// 1. TUS PROYECTOS (Añade aquí todos los que quieras)
const proyectos = [
  { name: "Sakila Cinema Analytics", url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", desc: "SQL & Data Analysis para optimizar inventario.", lang: "SQL" },
  { name: "The Friends Data Project", url: "https://github.com/NievesPerezData/proyecto_serieTV_Friends_Tableau", desc: "NLP y Sentiment Analysis sobre guiones.", lang: "Tableau" },
  { name: "Análisis Retail Oysho", url: "#", desc: "Optimización de KPIs y gestión de stock.", lang: "Excel/BI" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nieves Pérez Alonso | Data Analyst</title>
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="green-gradient-bg"></div>
    
    <Header />
    
    <main class="container_p">
      <section id="inicio" class="home-flex">
        <div class="perfil-container">
          <div class="circulo-foto">
            <img src="/img/tu-foto.webp" alt="Nieves Pérez" />
          </div>
          <h1 class="gradient-text">Hola, soy Nieves Pérez</h1>
          <p class="puesto">Data Analyst | Retail Expert</p>
        </div>
      </section>

      <section id="proyectos">
        <h2 class="titulo">Proyectos</h2>
        <div class="grid">
          {proyectos.map(p => (
            <div class="card">
              <div class="card-icons">
                <i class="fa-regular fa-folder"></i>
                <a href={p.url} target="_blank"><i class="fa-brands fa-github"></i></a>
              </div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <span class="lang">{p.lang}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="skills">
        <h2 class="titulo">Habilidades</h2>
        <div class="skills-flex">
          <div class="skill-box">
            <h4>Tech & Data</h4>
            <ul><li>Python</li><li>SQL</li><li>Tableau</li><li>Power BI</li></ul>
          </div>
          <div class="skill-box">
            <h4>Business & Retail</h4>
            <ul><li>Gestión KPIs</li><li>Estrategia Ventas</li><li>Metodologías Ágiles</li></ul>
          </div>
        </div>
      </section>

      <section id="sobremi">
        <h2 class="titulo">Sobre mí</h2>
        <p class="texto-largo">
          Con más de 6 años de experiencia en Oysho S.A., he transicionado al análisis de datos para unir mi conocimiento operativo con la potencia de la IA y el Big Data.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=ABeeZee&display=swap");

  /* VARIABLES DE COLOR (Verdes que te gustan) */
  :root {
    --verde-principal: #2d5a27; /* Verde Bosque */
    --verde-brillante: #4ade80; /* Verde Lima/Esmeralda suave */
    --fondo-oscuro: #050505;
  }

  html, body {
    background-color: var(--fondo-oscuro) !important;
    color: #f6f6f9 !important;
    margin: 0;
    font-family: 'ABeeZee', sans-serif;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  /* FONDO DEGRADADO VERDE */
  .green-gradient-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% -20%, #1a3a1a 0%, transparent 50%),
                radial-gradient(circle at 10% 80%, #0d250d 0%, transparent 40%);
    z-index: -1;
    pointer-events: none;
  }

  .container_p { max-width: 1200px; margin: 0 auto; padding: 0 20px; position: relative; }

  section { padding: 80px 0; scroll-margin-top: 100px; }

  .titulo { 
    color: var(--verde-brillante); 
    margin-bottom: 40px; 
    font-size: 2.2rem; 
    text-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
  }

  /* ESTILO DE LA FOTO */
  .home-flex { text-align: center; padding-top: 150px; }
  .circulo-foto {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 3px solid var(--verde-principal);
    margin: 0 auto 30px;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(45, 90, 39, 0.4);
    background: #111;
  }
  .circulo-foto img { width: 100%; height: 100%; object-fit: cover; }
  
  .gradient-text {
    background: linear-gradient(to right, #fff, var(--verde-brillante));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 3rem;
  }
  .puesto { color: var(--verde-brillante); font-size: 1.2rem; font-weight: bold; opacity: 0.9; }

  /* TARJETAS DE PROYECTOS */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
  .card { 
    background: rgba(15, 15, 15, 0.8); 
    padding: 30px; 
    border-radius: 12px; 
    border: 1px solid #1a2e1a; 
    transition: 0.4s ease;
    backdrop-filter: blur(5px);
  }
  .card:hover { 
    border-color: var(--verde-brillante); 
    transform: translateY(-8px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  .card-icons { display: flex; justify-content: space-between; color: var(--verde-brillante); font-size: 1.8rem; margin-bottom: 20px; }
  .card-icons a { color: #f6f6f9; }
  .lang { color: var(--verde-brillante); font-weight: bold; font-size: 0.8rem; letter-spacing: 1px; }

  /* HABILIDADES */
  .skills-flex { display: flex; gap: 40px; flex-wrap: wrap; }
  .skill-box { background: rgba(20, 30, 20, 0.4); padding: 25px; border-radius: 10px; flex: 1; min-width: 250px; border-left: 3px solid var(--verde-principal); }
  h4 { color: #fff; margin-bottom: 15px; }
  ul { list-style: none; padding: 0; }
  li { color: #aaa; margin-bottom: 10px; font-size: 0.95rem; }
  li::before { content: "•"; color: var(--verde-brillante); margin-right: 10px; }

  .texto-largo { color: #aaa; line-height: 1.8; max-width: 800px; font-size: 1.1rem; }
</style>
