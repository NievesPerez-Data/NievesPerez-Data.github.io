---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// 1. CONFIGURACIÓN DE TU USUARIO DE GITHUB
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  
  if (response.ok) {
    const data = await response.json();
    proyectos = data
      .filter(repo => !repo.name.includes('github.io'))
      .slice(0, 6)
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Proyecto de análisis de datos y estrategia.",
        lang: repo.language || "Data"
      }));
  } else {
    throw new Error("No se pudo conectar con la API");
  }
} catch (e) {
  error = "No se pudieron cargar los proyectos de GitHub.";
  proyectos = [{ 
    name: "Sakila Cinema Analytics", 
    url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
    desc: "Análisis de bases de datos SQL para optimizar inventario.", 
    lang: "SQL" 
  }];
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analyst</title>
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <style>
    /* Aseguramos que el cuerpo no tenga márgenes que desplacen el header */
    body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    .text-justified {
      text-align: justify;
      hyphens: auto;
    }
    /* Títulos de sección en blanco con línea decorativa */
    .section-title {
      color: #ffffff; 
      font-family: 'Inconsolata', monospace;
      font-size: 1.5rem;
      text-transform: uppercase;
      margin-bottom: 50px;
      display: flex;
      align-items: center;
      gap: 15px;
    }
    .section-title span {
      height: 1px;
      background: rgba(15, 112, 93, 0.4);
      flex-grow: 1;
    }
    /* Contenedor principal para centrar contenido del main igual que header/footer */
    .main-container {
      max-width: 1000px; /* Alineado con el container_p del CSS global */
      margin: 0 auto;
      padding: 0 20px;
    }
  </style>
</head>
<body style="background-color: #020502; color: #ffffff; font-family: 'Lato', sans-serif;">
  
  <Header />

  <main class="main-container">
    
    <!-- SECCIÓN INICIO -->
    <section id="inicio" style="display: flex; align-items: center; justify-content: space-between; padding: 160px 0 80px 0; min-height: 80vh; flex-wrap: wrap; gap: 40px;">
      <div style="flex: 1; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.8rem; font-weight: 700; margin-bottom: 10px;">Nieves Pérez Alonso</p>
        <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.2rem); line-height: 1.1; margin: 0 0 25px 0; font-weight: 800; text-transform: uppercase; font-family: 'Lato', sans-serif;">ESTRATEGIA DE NEGOCIO <br/> & DATA ANALYTICS</h1>
        
        <p class="text-justified" style="color: #d1d1d1; line-height: 1.6; margin-bottom: 40px; max-width: 580px; font-size: 1.1rem;">
          Trayectoria consolidada en dirección de unidades de negocio y gestión de equipos. Especializada en la interpretación de KPIs para el diseño de estrategias comerciales y el cumplimiento de objetivos mediante el análisis avanzado de datos.
        </p>
        <div id="contacto" style="display: flex; gap: 20px; margin-bottom: 40px; scroll-margin-top: 120px;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; border: 2px solid #0f705d;">Hablemos</a>
          <a href="#" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px;">Currículum</a>
        </div>
        <div style="display: flex; align-items: center; gap: 15px;">
          <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" style="color: #0f705d; font-size: 1.5rem;"><i class="fa-brands fa-github"></i></a>
          <a href="https://linkedin.com/in/nievesperezalonso" target="_blank" style="color: #0f705d; font-size: 1.5rem;"><i class="fa-brands fa-linkedin"></i></a>
        </div>
      </div>
      <div style="width: 300px; height: 300px; border-radius: 50%; border: 3px solid #0f705d; overflow: hidden; position: relative; box-shadow: 0 0 30px rgba(15, 112, 93, 0.4);">
        <img src="/img/tu-foto.webp" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://via.placeholder.com/350x350/020502/0f705d?text=NPA'"/>
      </div>
    </section>

    <!-- SECCIÓN PROYECTOS -->
    <section id="proyectos" style="padding: 100px 0;">
      <h2 class="section-title">
        Proyectos <span></span>
      </h2>
      {error && <p style="color: #ff6b6b;">{error}</p>}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;">
        {proyectos.map(p => (
          <div style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.2); padding: 30px; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; transition: 0.3s;" onmouseover="this.style.borderColor='#0f705d'" onmouseout="this.style.borderColor='rgba(15, 112, 93, 0.2)'">
            <div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 20px; color: #0f705d;">
                <i class="fa-regular fa-folder" style="font-size: 1.5rem;"></i>
                <a href={p.url} target="_blank" style="color: #ffffff; opacity: 0.7;"><i class="fa-brands fa-github"></i></a>
              </div>
              <h3 style="color: #ffffff; margin-bottom: 10px; text-transform: capitalize; font-family: 'Inconsolata', monospace; font-size: 1.1rem;">{p.name}</h3>
              <p class="text-justified" style="color: #aaaaaa; font-size: 0.85rem; line-height: 1.5; margin-bottom: 20px;">{p.desc}</p>
            </div>
            <span style="color: #0f705d; font-family: 'Inconsolata', monospace; font-weight: bold; font-size: 0.75rem;">{p.lang}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN HABILIDADES -->
    <section id="habilidades" style="padding: 100px 0;">
      <h2 class="section-title">
        Habilidades <span></span>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 20px;">
        {[
          { name: "Python", icon: "fa-brands fa-python" },
          { name: "MySQL", icon: "fa-solid fa-database" },
          { name: "Pandas", icon: "fa-solid fa-table" },
          { name: "Tableau", icon: "fa-solid fa-chart-pie" },
          { name: "Power BI", icon: "fa-solid fa-chart-column" },
          { name: "Ollama IA", icon: "fa-solid fa-robot" },
          { name: "Scraping", icon: "fa-solid fa-spider" },
          { name: "Excel", icon: "fa-regular fa-file-excel" },
          { name: "Git/GitHub", icon: "fa-brands fa-github" }
        ].map(skill => (
          <div style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.1); padding: 25px; border-radius: 8px; text-align: center; transition: 0.3s;">
             <i class={skill.icon} style="font-size: 1.8rem; color: #0f705d; display: block; margin-bottom: 10px;"></i>
             <span style="font-family: 'Inconsolata', monospace; font-size: 0.8rem; font-weight: 700; color: #ffffff;">{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN FORMACIÓN -->
    <section id="estudios" style="padding: 100px 0;">
      <h2 class="section-title">
        Formación <span></span>
      </h2>
      
      <div style="display: flex; flex-direction: column; gap: 40px;">
        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.1rem; color: #ffffff; font-family: 'Inconsolata', monospace; letter-spacing: 1px;">ADALAB</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d; font-size: 0.95rem;">Bootcamp Data Analytics & Inteligencia Artificial aplicada</p>
          <div style="color: #888888; font-size: 0.8rem; font-family: 'Inconsolata', monospace;">Online | 2025 - 2026</div>
        </div>

        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.1rem; color: #ffffff; font-family: 'Inconsolata', monospace; letter-spacing: 1px;">UNIVERSIDAD COMPLUTENSE DE MADRID</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d; font-size: 0.95rem;">Máster en Educación Artística en Instituciones Sociales y Culturales</p>
          <div style="color: #888888; font-size: 0.8rem; font-family: 'Inconsolata', monospace;">Madrid | 2014 - 2015</div>
        </div>

        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.1rem; color: #ffffff; font-family: 'Inconsolata', monospace; letter-spacing: 1px;">UNIVERSIDAD AUTÓNOMA DE MADRID</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d; font-size: 0.95rem;">Grado en Historia del Arte</p>
          <div style="color: #888888; font-size: 0.8rem; font-family: 'Inconsolata', monospace;">Madrid | 2009 - 2014</div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN SOBRE MÍ -->
    <section id="sobremi" style="padding: 100px 0 150px 0;">
      <h2 class="section-title">
        Sobre mí <span></span>
      </h2>
      <div class="text-justified" style="color: #aaaaaa; max-width: 850px; line-height: 1.8; font-size: 1.1rem;">
        <p style="margin-bottom: 20px;">
          Trayectoria consolidada en dirección de unidades de negocio y gestión de equipos en el sector Retail. Mi valor diferencial reside en la combinación de una experiencia directa en toma de decisiones operativas con una sólida competencia técnica para optimizar procesos y detectar oportunidades de crecimiento mediante el análisis de datos.
        </p>
        <p style="margin-bottom: 20px;">
          Como especialista en la interpretación de KPIs de rendimiento, diseño estrategias comerciales alineadas con el cumplimiento de objetivos de venta. Cuento con formación técnica avanzada en Análisis de Datos, con capacidad para explorar, limpiar y transformar datasets complejos en información útil y accionable.
        </p>
        <p>
          Mi enfoque se centra en unir el mundo de las operaciones con la analítica avanzada, garantizando que cada dato se transforme en una decisión estratégica que aporte valor real al negocio.
        </p>
      </div>
    </section>

  </main>

  <Footer />

</body>
</html>
