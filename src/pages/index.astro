<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nieves Pérez Alonso | Data Analyst & Retail Specialist</title>
    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <!-- Devicon -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
    
    <style>
        :root {
            --primary: #0f705d;
            --primary-glow: rgba(15, 112, 93, 0.4);
            --bg-dark: #020502;
            --card-bg: rgba(15, 112, 93, 0.05);
            --text-main: #ffffff;
            --text-dim: #d1d1d1;
            --font-mono: 'Inconsolata', monospace;
            --font-sans: 'Lato', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: var(--font-sans);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* --- HEADER --- */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 0 40px;
            height: 85px;
            background: rgba(2, 5, 2, 0.95);
            backdrop-filter: blur(12px);
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(15, 112, 93, 0.2);
        }

        .header-logo {
            font-family: var(--font-mono);
            font-weight: 700;
            color: var(--text-main);
            text-decoration: none;
            font-size: 1rem;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav a {
            text-decoration: none;
            color: var(--text-dim);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            transition: 0.3s;
            letter-spacing: 1px;
        }

        nav a:hover { color: var(--primary); }

        /* --- LAYOUT --- */
        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        section { padding: 100px 0 60px 0; }

        .section-title {
            font-family: var(--font-mono);
            font-size: 1.4rem;
            text-transform: uppercase;
            margin-bottom: 50px;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .section-title::after {
            content: "";
            height: 1px;
            background: rgba(15, 112, 93, 0.3);
            flex-grow: 1;
        }

        /* --- HERO SECTION --- */
        .hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 90vh;
            flex-wrap: wrap;
            gap: 60px;
            padding-top: 140px;
        }

        .hero-content { flex: 1; min-width: 320px; }

        .hero-pre {
            color: var(--primary);
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 15px;
        }

        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            line-height: 1.1;
            margin-bottom: 25px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .hero-desc {
            color: var(--text-dim);
            font-size: 1.2rem;
            max-width: 600px;
            margin-bottom: 40px;
        }

        .hero-image-container {
            width: 350px;
            height: 350px;
            border-radius: 50%;
            border: 3px solid var(--primary);
            position: relative;
            padding: 15px;
            box-shadow: 0 0 30px var(--primary-glow);
        }

        .hero-image {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background: #111;
        }

        .cta-group { display: flex; gap: 20px; margin-bottom: 40px; }

        .btn {
            padding: 14px 35px;
            text-decoration: none;
            font-family: var(--font-mono);
            font-weight: 700;
            border-radius: 4px;
            transition: 0.3s;
            text-align: center;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            border: 2px solid var(--primary);
        }

        .btn-outline {
            border: 2px solid var(--primary);
            color: white;
        }

        /* --- SKILLS GRID --- */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 25px;
        }

        .skill-card {
            background: var(--card-bg);
            border: 1px solid rgba(15, 112, 93, 0.1);
            border-radius: 8px;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .skill-card i { font-size: 2.5rem; color: var(--primary); }
        .skill-card span { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; }

        /* --- EDUCATION --- */
        .edu-item {
            border-left: 3px solid var(--primary);
            padding: 0 0 40px 30px;
            position: relative;
        }

        .edu-item h3 { font-size: 1.3rem; margin-bottom: 5px; }
        .edu-item p { color: var(--primary); font-weight: 700; margin-bottom: 5px; }
        .edu-meta { color: #888; font-family: var(--font-mono); font-size: 0.9rem; }

        /* --- FOOTER --- */
        footer {
            padding: 80px 20px;
            text-align: center;
            border-top: 1px solid rgba(15, 112, 93, 0.1);
        }

        .social-links { display: flex; justify-content: center; gap: 30px; margin-bottom: 30px; }
        .social-links a { color: var(--primary); font-size: 1.8rem; transition: 0.3s; }

        @media (max-width: 992px) {
            .hero { justify-content: center; text-align: center; }
            .hero-desc { margin: 0 auto 40px auto; }
            .cta-group { justify-content: center; }
        }
    </style>
</head>
<body>

    <header>
        <a href="#inicio" class="header-logo">Nieves Pérez Alonso</a>
        <nav>
            <ul>
                <li><a href="#proyectos">Proyectos</a></li>
                <li><a href="#habilidades">Habilidades</a></li>
                <li><a href="#formacion">Formación</a></li>
                <li><a href="#sobre-mi">Sobre mí</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <!-- SECCIÓN HERO -->
        <section id="inicio" class="hero">
            <div class="hero-content">
                <p class="hero-pre">Nieves Pérez Alonso</p>
                <h1 class="hero-title">Data Analyst <br/> & Retail Specialist</h1>
                <p class="hero-desc">
                    Especializada en transformar datos complejos en decisiones estratégicas. 
                    Más de 6 años optimizando operaciones en el sector Retail para maximizar la rentabilidad.
                </p>
                <div class="cta-group">
                    <a href="mailto:nievesperezalonso@gmail.com" class="btn btn-primary">Hablemos</a>
                    <a href="#" class="btn btn-outline">Currículum</a>
                </div>
                <div class="social-links" style="justify-content: flex-start;">
                    <a href="https://github.com/NievesPerez-Data" target="_blank"><i class="fa-brands fa-github"></i></a>
                    <a href="https://linkedin.com/in/nievesperezalonso" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
                </div>
            </div>
            <div class="hero-image-container">
                <img 
                    src="https://media.licdn.com/dms/image/v2/D4D03AQGnS9mQv5_2PA/profile-displayphoto-shrink_800_800/profile-displayphoto-shrink_800_800/0/1710410000000?e=1744243200&v=beta&t=example" 
                    alt="Nieves Pérez Alonso" 
                    class="hero-image" 
                    onerror="this.src='https://via.placeholder.com/350x350/020502/0f705d?text=NPA';">
            </div>
        </section>

        <!-- SECCIÓN SOBRE MÍ -->
        <section id="sobre-mi">
            <h2 class="section-title">Sobre mí</h2>
            <div style="max-width: 900px;">
                <p style="font-size: 1.15rem; color: var(--text-dim); margin-bottom: 25px; line-height: 1.8;">
                    Tras años liderando operaciones en el sector **Retail (Oysho - Inditex)**, mi transición al análisis de datos responde a una pasión genuina por optimizar procesos mediante el dato. Entiendo la operativa de negocio desde dentro, lo que me permite no solo analizar números, sino identificar el impacto real detrás de cada métrica.
                </p>
                <p style="font-size: 1.15rem; color: var(--text-dim); line-height: 1.8;">
                    Combino esta visión estratégica con un stack técnico sólido consolidado en **Adalab**, enfocándome en la resolución de problemas complejos y la creación de visualizaciones que facilitan la toma de decisiones críticas para la rentabilidad y el crecimiento.
                </p>
            </div>
        </section>

        <!-- SECCIÓN HABILIDADES -->
        <section id="habilidades">
            <h2 class="section-title">Habilidades Técnicas</h2>
            <div class="skills-grid">
                <div class="skill-card"><i class="devicon-python-plain"></i><span>Python</span></div>
                <div class="skill-card"><i class="devicon-mysql-plain"></i><span>MySQL</span></div>
                <div class="skill-card"><i class="devicon-pandas-plain"></i><span>Pandas</span></div>
                <div class="skill-card"><i class="fa-solid fa-chart-pie"></i><span>Tableau</span></div>
                <div class="skill-card"><i class="fa-solid fa-chart-column"></i><span>Power BI</span></div>
                <div class="skill-card"><i class="fa-solid fa-brain"></i><span>Ollama IA</span></div>
                <div class="skill-card"><i class="fa-solid fa-spider"></i><span>Scraping</span></div>
                <div class="skill-card"><i class="fa-regular fa-file-excel"></i><span>Excel</span></div>
                <div class="skill-card"><i class="devicon-git-plain"></i><span>Git</span></div>
            </div>
        </section>

        <!-- SECCIÓN FORMACIÓN -->
        <section id="formacion">
            <h2 class="section-title">Formación Académica</h2>
            <div class="edu-item">
                <p>2024 - 2025</p>
                <h3>Bootcamp Data Analytics & IA</h3>
                <span class="edu-meta">Adalab // Online</span>
            </div>
            <div class="edu-item">
                <p>2014 - 2015</p>
                <h3>Máster en Educación Artística</h3>
                <span class="edu-meta">Universidad Complutense de Madrid (UCM)</span>
            </div>
            <div class="edu-item">
                <p>2009 - 2014</p>
                <h3>Grado en Historia del Arte</h3>
                <span class="edu-meta">Universidad Autónoma de Madrid (UAM)</span>
            </div>
        </section>
    </main>

    <footer>
        <div class="social-links">
            <a href="https://github.com/NievesPerez-Data"><i class="fa-brands fa-github"></i></a>
            <a href="https://linkedin.com/in/nievesperezalonso"><i class="fa-brands fa-linkedin"></i></a>
            <a href="mailto:nievesperezalonso@gmail.com"><i class="fa-solid fa-envelope"></i></a>
        </div>
        <p style="color: #666; font-family: var(--font-mono); font-size: 0.8rem;">
            © 2026 NIEVES PÉREZ ALONSO | DISEÑADO CON DATA & PASIÓN
        </p>
    </footer>

</body>
</html>
