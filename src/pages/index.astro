---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// Configuración de GitHub
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  // Obtenemos los repositorios reales de tu GitHub
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  
  if (response.ok) {
    const data = await response.json();
    
    // FILTRO: Excluimos el repo del portfolio y otros que no quieras mostrar
    // Puedes añadir más nombres al array 'reposAOcultar'
    const reposAOcultar = [`${GITHUB_USERNAME.toLowerCase()}.github.io`, "portfolio-astro"];
    
    proyectos = data
      .filter(repo => !reposAOcultar.includes(repo.name.toLowerCase()))
      .slice(0, 6) // Nos quedamos con los 6 más recientes tras filtrar
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Sin descripción disponible en el repositorio.",
        lang: repo.language || "Markdown"
      }));
  } else {
    throw new Error("No se pudieron cargar los repositorios");
  }
} catch (e) {
  error = "Hubo un problema conectando con GitHub.";
  proyectos = [
    { 
      name: "Sakila Cinema Analytics", 
      url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
      desc: "Análisis de bases de datos SQL para optimizar inventario y comportamiento de clientes.", 
      lang: "SQL" 
    }
  ];
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analyst</title>
  <!-- Font Awesome para los iconos -->
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  <!-- Devicon para logos tecnológicos -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>
<body style="background-color: #020502; color: #ffffff; margin: 0; font-family: 'Lato', sans-serif;">
  <Header />

  <main style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <!-- SECCIÓN INICIO / CONTACTO -->
    <section id="inicio" style="display: flex; align-items: center; justify-content: space-between; padding: 160px 0 80px 0; min-height: 80vh; flex-wrap: wrap; gap: 40px;">
      
      <div style="flex: 1; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.4rem; font-weight: 700; margin-bottom: 10px;">Nieves Pérez Alonso</p>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin: 0 0 25px 0; font-weight: 800; text-transform: uppercase;">Data Analytics & <br/> Operations Strategy</h1>
        
        <p style="color: #d1d1d1; line-height: 1.6; margin-bottom: 40px; max-width: 580px; font-size: 1.1rem; text-align: justify;">
          Integrando analítica avanzada y visión estratégica para optimizar procesos y detectar oportunidades de crecimiento para la toma de decisiones de alto impacto.
        </p>

        <div id="contacto" style="display: flex; gap: 20px; margin-bottom: 40px; scroll-margin-top: 120px;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; border: 2px solid #0f705d; transition: 0.3s;">Hablemos</a>
          <a href="/docs/CV_Nieves_Perez.pdf" target="_blank" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; transition: 0.3s;">
          Ver Currículum
        </a>
      </div>

        <div style="display: flex; align-items: center; gap: 15px; color: #ffffff;">
          <span style="font-size: 0.95rem;">Echa un vistazo a mi</span>
          <div style="display: flex; gap: 10px;">
            <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener noreferrer" style="background: #0f705d; color: #ffffff; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 4px; text-decoration: none;" aria-label="GitHub">
              <i class="fa-brands fa-github"></i>
            </a>
            <a href="https://linkedin.com/in/nievesperezalonso" target="_blank" rel="noopener noreferrer" style="background: #0f705d; color: #ffffff; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 4px; text-decoration: none;" aria-label="LinkedIn">
              <i class="fa-brands fa-linkedin"></i>
            </a>
          </div>
        </div>
      </div>
      
      <div style="position: relative; width: 350px; height: 350px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <div style="position: absolute; width: 120%; height: 120%; background: radial-gradient(circle, rgba(15, 112, 93, 0.25) 0%, transparent 70%); border-radius: 50%;"></div>
        <div style="position: relative; width: 300px; height: 300px; border-radius: 50%; overflow: hidden; border: 1px solid rgba(15, 112, 93, 0.3); background: #0a0a0a; z-index: 2;">
          <img src="/img/profile.jpg" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.style.opacity='0'"/>
        </div>
      </div>
    </section>

    <!-- SECCIÓN PROYECTOS -->
    <section id="proyectos" style="padding: 100px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px;">Proyectos</h2>
      
      {error && <p style="color: #ff6b6b; font-family: 'Inconsolata', monospace;">{error}</p>}
      
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
        {proyectos.map(p => (
          <div style="background: rgba(15, 112, 93, 0.03); border: 1px solid rgba(15, 112, 93, 0.1); padding: 30px; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 25px; color: #0f705d;">
                <i class="fa-regular fa-folder" style="font-size: 1.8rem;"></i>
                <a href={p.url} target="_blank" rel="noopener noreferrer" style="color: #ffffff; opacity: 0.6;">
                  <i class="fa-brands fa-github" style="font-size: 1.3rem;"></i>
                </a>
              </div>
              <h3 style="margin: 0 0 12px 0; font-size: 1.2rem; color: #ffffff; text-transform: capitalize;">{p.name}</h3>
              <p style="color: #aaaaaa; font-size: 0.9rem; line-height: 1.6; margin-bottom: 20px; text-align: justify;">{p.desc}</p>
            </div>
            <div style="color: #0f705d; font-size: 0.8rem; font-weight: 700; font-family: 'Inconsolata', monospace;">
              &lt; {p.lang} /&gt;
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN HABILIDADES -->
    <section id="habilidades" style="padding: 100px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px;">Habilidades</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 20px;">
        {[
          { name: "Python", icon: "devicon-python-plain" },
          { name: "MySQL", icon: "devicon-mysql-plain" },
          { name: "Tableau", icon: "fa-solid fa-chart-line" },
          { name: "Power BI", icon: "fa-solid fa-chart-column" },
          { name: "Excel", icon: "fa-regular fa-file-excel" },
          { name: "Ollama (IA)", icon: "fa-solid fa-microchip" },
          { name: "Git", icon: "devicon-git-plain" },
          { name: "GitHub", icon: "devicon-github-original" },
          { name: "VS Code", icon: "devicon-vscode-plain" },
          { name: "Pandas", icon: "devicon-pandas-plain" },
          { name: "NumPy", icon: "devicon-numpy-plain" },
          { name: "Selenium", icon: "devicon-selenium-original" },
          { name: "BeautifulSoup", icon: "fa-solid fa-spider" }
        ].map(skill => (
          <div style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.1); border-radius: 8px; padding: 20px 10px; display: flex; flex-direction: column; align-items: center; gap: 12px; transition: 0.3s;">
            <i class={skill.icon} style="font-size: 2rem; color: #0f705d;"></i>
            <span style="font-family: 'Inconsolata', monospace; font-size: 0.8rem; font-weight: 700; color: #ffffff; text-align: center;">{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN ESTUDIOS -->
    <section id="estudios" style="padding: 100px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px;">Estudios</h2>
      
      <div style="display: flex; flex-direction: column; gap: 40px;">
        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.2rem; color: #ffffff;">ADALAB</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Bootcamp Data Analytics & Inteligencia Artificial aplicada</p>
          <div style="display: flex; gap: 15px; color: #888888; font-size: 0.9rem;">
            <span>Online</span>
            <span>|</span>
            <span>2025-2026</span>
          </div>
        </div>

        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.2rem; color: #ffffff;">UNIVERSIDAD COMPLUTENSE DE MADRID</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Máster en Educación Artística en Instituciones Sociales y Culturales</p>
          <div style="display: flex; gap: 15px; color: #888888; font-size: 0.9rem;">
            <span>Madrid</span>
            <span>|</span>
            <span>2014-2015</span>
          </div>
        </div>

        <div style="border-left: 3px solid #0f705d; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.2rem; color: #ffffff;">UNIVERSIDAD AUTÓNOMA DE MADRID</h3>
          <p style="margin: 5px 0; font-weight: 700; color: #0f705d;">Grado en Historia del Arte</p>
          <div style="display: flex; gap: 15px; color: #888888; font-size: 0.9rem;">
            <span>Madrid</span>
            <span>|</span>
            <span>2009-2014</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN SOBRE MÍ -->
    <section id="sobremi" style="padding: 100px 0 150px 0;">
      <h2 style="color: #ffffff; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 40px;">Sobre mí</h2>
      <div style="color: #aaaaaa; max-width: 850px; line-height: 1.6; font-size: 1.1rem; margin: 0; display: flex; flex-direction: column; gap: 15px; text-align: justify;">
        <p style="margin: 0;">
          Mi trayectoria se ha centrado en la dirección estratégica y la optimización operativa, donde descubrí que el verdadero valor diferencial reside en la capacidad de transformar datos brutos en decisiones inteligentes. Combino una sólida experiencia en gestión de equipos y unidades de negocio con una formación técnica avanzada en Análisis de Datos, lo que me permite aportar una visión de negocio única junto a una capacidad real para traducir datasets complejos en KPIs de rendimiento que impactan directamente en el crecimiento.
        </p>
        <p style="margin: 0;">
          Cuento con experiencia práctica en la exploración, limpieza y transformación de datos (ETL), asegurando siempre que la información sea precisa, útil y actionable para el diseño de estrategias comerciales. Mi enfoque no solo analiza el pasado, sino que utiliza la excelencia técnica para optimizar procesos operativos y detectar oportunidades de mercado mediante el análisis avanzado.
        </p>
        <p style="margin: 0;">
          Mi valor reside en unir el rigor de la analítica con la visión ejecutiva necesaria para garantizar que cada dato se transforme en una decisión estratégica que aporte un valor real y medible al negocio.
        </p>
      </div>
      <div style="flex-shrink: 0;">
      <img 
        src="/img/Nieves_Data.PNG"
        alt="Nieves Pérez Data"
        style="
          width: 280px;
          border-radius: 6px;
          border: 3px solid #0f705d;
          box-shadow: 0 0 25px rgba(15,112,93,0.4);
        "
      />
    </div>
    
    </div>
    </section>

  </main>

  <Footer />
</body>
</html>
