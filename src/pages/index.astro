---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// Lista de proyectos actualizada
const proyectos = [
  { name: "Sakila Cinema Analytics", url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", desc: "SQL & Data Analysis para optimizar inventario.", lang: "SQL" },
  { name: "The Friends Data Project", url: "https://github.com/NievesPerezData/proyecto_serieTV_Friends_Tableau", desc: "NLP y Sentiment Analysis sobre guiones.", lang: "Tableau" },
  { name: "Análisis Retail Oysho", url: "#", desc: "Optimización de KPIs y gestión de stock.", lang: "Excel/BI" },
  { name: "Accidentes viales en Madrid", url: "#", desc: "Estudio estadístico sobre la siniestralidad vial.", lang: "Python" },
  { name: "Diamond Price Predictor", url: "#", desc: "Modelo de ML para predecir el precio de diamantes.", lang: "ML" },
  { name: "E-commerce Segmentation", url: "#", desc: "Clustering de clientes mediante K-Means.", lang: "Python" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nieves Pérez Alonso | Data Analyst</title>
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />
    
    <main class="container_p">
      <!-- SECCIÓN: INICIO (ESTILO IMAGEN Y LIGADO A CONTACTO) -->
      <section id="inicio" class="hero-section">
        <div class="hero-content">
          <p class="hero-name">Nieves Pérez Alonso</p>
          <h1 class="hero-title">DATA ANALYST <br/> RETAIL SPECIALIST</h1>
          
          <p class="hero-description">
            Especializada en transformar datos complejos en decisiones estratégicas. 
            Con un fuerte background en gestión operativa de Retail y apasionada por la analítica de negocio. 
            Capaz de traducir comportamientos de mercado en insights accionables y optimizar el rendimiento.
          </p>

          <div id="contacto" class="hero-buttons">
            <a href="mailto:tu-email@ejemplo.com" class="btn-primary">Hablemos</a>
            <a href="/cv-nieves-perez.pdf" target="_blank" class="btn-secondary">Ver Currículum</a>
          </div>

          <div class="hero-social-line">
            <span>Echa un vistazo a mi</span>
            <div class="social-icons">
              <a href="https://github.com/tu-perfil" target="_blank"><i class="fa-brands fa-github"></i></a>
              <a href="https://linkedin.com/in/tu-perfil" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
            </div>
          </div>
        </div>
        
        <div class="hero-image-container">
          <div class="hero-image-glow"></div>
          <div class="hero-image-mask">
            <img src="/img/tu-foto.webp" alt="Nieves Pérez" onerror="this.style.opacity='0'"/>
          </div>
        </div>
      </section>

      <!-- SECCIÓN: PROYECTOS -->
      <section id="proyectos" class="section-padding">
        <h2 class="section-title">Proyectos</h2>
        <div class="projects-grid">
          {proyectos.map(p => (
            <div class="card-proyecto">
              <div class="card-header">
                <i class="fa-regular fa-folder"></i>
                <a href={p.url} target="_blank"><i class="fa-brands fa-github"></i></a>
              </div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <div class="card-footer">
                &lt; {p.lang} /&gt;
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SECCIÓN: HABILIDADES -->
      <section id="habilidades" class="section-padding">
        <h2 class="section-title">// Habilidades</h2>
        <div class="skills-box">
           <p>Python • SQL • Tableau • Power BI • Análisis de KPIs • Estrategia de Retail • Git • GitHub</p>
        </div>
      </section>

      <!-- SECCIÓN: ESTUDIOS -->
      <section id="estudios" class="section-padding">
        <h2 class="section-title">// Estudios</h2>
        <div class="study-item">
          <h3>Bootcamp Data Analytics</h3>
          <p>Ironhack | 2023</p>
        </div>
        <div class="study-item">
          <h3>Grado Superior / Universitario</h3>
          <p>Institución | Año</p>
        </div>
      </section>

      <!-- SECCIÓN: SOBRE MÍ -->
      <section id="sobremi" class="section-padding" style="margin-bottom: 100px;">
        <h2 class="section-title">// Sobre mí</h2>
        <p class="about-text">
          Tras años en el sector Retail, mi enfoque como Data Analyst es unir la realidad del negocio con la potencia de los datos para generar soluciones que impacten directamente en la rentabilidad.
        </p>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  .section-padding { padding-top: 100px; }

  /* HERO SECTION */
  .hero-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 160px;
    padding-bottom: 80px;
    gap: 40px;
    min-height: 85vh;
  }

  .hero-name {
    color: #01be96;
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 10px;
    font-family: 'Inconsolata', monospace;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 25px;
    text-transform: uppercase;
    font-weight: 800;
  }

  .hero-description {
    color: #d1d1d1;
    font-family: 'Lato', sans-serif;
    line-height: 1.6;
    margin-bottom: 40px;
    font-size: 1.05rem;
    max-width: 580px;
  }

  .hero-buttons {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
    scroll-margin-top: 120px;
  }

  .btn-primary {
    background-color: #01be96;
    color: #000;
    padding: 14px 30px;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
    transition: 0.3s;
    border: 2px solid #01be96;
  }

  .btn-secondary {
    border: 2px solid #01be96;
    color: #fff;
    padding: 14px 30px;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
    transition: 0.3s;
  }

  .btn-secondary:hover { background: #01be96; color: #000; }

  .hero-social-line {
    display: flex;
    align-items: center;
    gap: 15px;
    color: #fff;
  }

  .social-icons { display: flex; gap: 12px; }

  .social-icons a {
    color: #000;
    background-color: #01be96;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: 0.3s;
  }

  .social-icons a:hover { transform: translateY(-5px); }

  /* IMAGEN */
  .hero-image-container {
    position: relative;
    width: 380px;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-glow {
    position: absolute;
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, rgba(1, 190, 150, 0.2) 0%, transparent 70%);
    border-radius: 50%;
  }

  .hero-image-mask {
    position: relative;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #0a0a0a;
    border: 1px solid rgba(1, 190, 150, 0.3);
    z-index: 2;
  }

  .hero-image-mask img { width: 100%; height: 100%; object-fit: cover; }

  /* GENERAL */
  .section-title {
    font-size: 1.5rem;
    color: #01be96;
    margin-bottom: 40px;
    font-family: 'Inconsolata', monospace;
    text-transform: uppercase;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 25px;
  }

  .skills-box {
    border: 1px solid rgba(1, 190, 150, 0.2);
    padding: 30px;
    background: rgba(1, 190, 150, 0.03);
    color: #aaa;
  }

  .study-item {
    border-left: 2px solid #01be96;
    padding-left: 20px;
    margin-bottom: 25px;
  }

  .about-text { color: #aaa; max-width: 800px; line-height: 1.8; }

  @media (max-width: 968px) {
    .hero-section { flex-direction: column-reverse; text-align: center; }
    .hero-buttons, .hero-social-line { justify-content: center; }
  }
</style>
