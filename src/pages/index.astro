@import url('https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap');

:root {
  --verde-principal: #053931;       /* Tu verde exacto */
  --verde-halo: rgba(5, 57, 49, 0.5);
  --fondo-negro: #020502;
  --blanco-puro: #ffffff;
  --blanco-traslucido: rgba(255, 255, 255, 0.5); /* Texto tipo encabezado */
}

html, body {
  background-color: var(--fondo-negro) !important;
  color: var(--blanco-puro) !important;
  margin: 0;
  padding: 0;
  font-family: 'Inconsolata', monospace;
  scroll-behavior: smooth;
}

h1, h2, h3 {
  font-family: 'Inconsolata', monospace;
  color: var(--blanco-puro);
}

.container_p {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 20px;
}

section {
  padding: 80px 0;
  scroll-margin-top: 90px;
}

/* EFECTO TEXTO TRASLÚCIDO (Como el encabezado) */
.texto-traslucido {
  color: var(--blanco-traslucido);
  font-family: 'Lato', sans-serif;
  font-weight: 400;
}

/* FORMATO CÁPSULA VERTICAL PARA PROYECTOS */
.card-proyecto {
  background: rgba(5, 57, 49, 0.05);
  border: 1px solid var(--verde-principal);
  padding: 40px 30px;
  border-radius: 50px; /* Forma de cápsula */
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all 0.3s ease;
  min-height: 400px;
  justify-content: space-between;
}

.card-proyecto:hover {
  background: rgba(5, 57, 49, 0.15);
  box-shadow: 0 0 20px var(--verde-halo);
  transform: translateY(-5px);
}
