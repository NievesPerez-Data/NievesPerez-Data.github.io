---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";

const proyectos = [
  { name: "Sakila Cinema Analytics", url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", desc: "SQL & Data Analysis para optimizar inventario.", lang: "SQL" },
  { name: "The Friends Data Project", url: "https://github.com/NievesPerezData/proyecto_serieTV_Friends_Tableau", desc: "NLP y Sentiment Analysis sobre guiones.", lang: "Tableau" },
  { name: "Análisis Retail Oysho", url: "#", desc: "Optimización de KPIs y gestión de stock.", lang: "Excel/BI" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nieves Pérez Alonso | Data Analyst</title>
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  </head>
  <body>
    
    <Header />
    
    <main class="container_p">
      <section id="inicio" class="home-flex">
        <div class="perfil-container">
          <div class="circulo-foto">
            <img src="/img/tu-foto.webp" alt="Nieves Pérez" />
          </div>
          <h1 class="nombre">Nieves Pérez Alonso</h1>
          <p class="puesto">Data Analyst | Retail Expert</p>
        </div>
      </section>

      <section id="proyectos">
        <h2 class="titulo">Proyectos</h2>
        <div class="grid">
          {proyectos.map(p => (
            <div class="card">
              <div class="card-icons">
                <i class="fa-regular fa-folder"></i>
                <a href={p.url} target="_blank"><i class="fa-brands fa-github"></i></a>
              </div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <span class="lang">{p.lang}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="skills">
        <h2 class="titulo">Habilidades</h2>
        <div class="skills-flex">
          <div class="skill-box">
            <h4>Tech & Data</h4>
            <ul><li>Python (Pandas, NumPy)</li><li>SQL (MySQL)</li><li>Tableau & Power BI</li></ul>
          </div>
          <div class="skill-box">
            <h4>Business</h4>
            <ul><li>Análisis de KPIs</li><li>Estrategia Retail</li><li>Metodologías Ágiles</li></ul>
          </div>
        </div>
      </section>

      <section id="estudios">
        <h2 class="titulo">Estudios</h2>
        <div class="estudios-lista">
          <div class="estudio-item">
            <h3>Bootcamp Data Analytics</h3>
            <p>Adalab | 2024 - 2025</p>
          </div>
          <div class="estudio-item">
            <h3>Máster en Educación Artística</h3>
            <p>Universidad Complutense de Madrid</p>
          </div>
        </div>
      </section>

      <section id="sobremi">
        <h2 class="titulo">Sobre mí</h2>
        <p class="texto-largo">
          Store Manager con más de 6 años de experiencia en Oysho (Inditex). Experta en optimización de ventas y gestión de equipos, ahora enfocada en extraer valor de los datos a través del análisis avanzado.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=ABeeZee&display=swap");

  /* COLORES VERDES SÓLIDOS */
  :root {
    --verde-fondo: #050a05; /* Un verde casi negro, muy profundo */
    --verde-borde: #1a2e1a;
    --verde-detalle: #4ade80; /* El verde brillante para resaltar */
  }

  html, body {
    background-color: var(--verde-fondo) !important;
    color: #f6f6f9 !important;
    margin: 0;
    padding: 0;
    font-family: 'ABeeZee', sans-serif;
    scroll-behavior: smooth;
  }

  .container_p { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  section { padding: 80px 0; scroll-margin-top: 90px; }
  
  .titulo { color: var(--verde-detalle); font-size: 2rem; margin-bottom: 30px; }

  /* FOTO */
  .home-flex { text-align: center; padding-top: 100px; }
  .circulo-foto {
    width: 200px; height: 200px; border-radius: 50%;
    border: 3px solid var(--verde-detalle); margin: 0 auto 20px;
    overflow: hidden; background: #000;
  }
  .circulo-foto img { width: 100%; height: 100%; object-fit: cover; }
  .nombre { font-size: 3rem; margin: 10px 0; color: #fff; }
  .puesto { color: var(--verde-detalle); font-weight: bold; font-size: 1.2rem; }

  /* TARJETAS */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .card { 
    background: #0a0f0a; border: 1px solid var(--verde-borde); padding: 25px; border-radius: 12px;
    transition: 0.3s;
  }
  .card:hover { border-color: var(--verde-detalle); transform: translateY(-5px); }
  .card-icons { display: flex; justify-content: space-between; color: var(--verde-detalle); font-size: 1.5rem; margin-bottom: 15px; }
  .lang { color: var(--verde-detalle); font-size: 0.8rem; font-weight: bold; }

  /* LISTAS */
  .estudio-item { border-left: 2px solid var(--verde-detalle); padding-left: 20px; margin-bottom: 25px; }
  .skill-box { background: #0a0f0a; padding: 20px; border-radius: 8px; flex: 1; min-width: 250px; border: 1px solid var(--verde-borde); }
  .skills-flex { display: flex; gap: 20px; flex-wrap: wrap; }
  ul { list-style: none; padding: 0; }
  li { color: #aaa; margin-bottom: 8px; }
  li::before { content: "▹ "; color: var(--verde-detalle); }
  
  .texto-largo { color: #bbb; line-height: 1.8; max-width: 800px; }
</style>
