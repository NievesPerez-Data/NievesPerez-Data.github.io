---
/* src/pages/index.astro */
import Header from "../components/header/Header.astro";
import Main from "../components/main/main.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nieves Pérez Alonso | Data Analyst</title>
    <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <Header />
    <Main />
    <Footer />
  </body>
</html>

<style is:global>
  /* ESTO RECUPERA EL COLOR NEGRO Y EL FORMATO */
  :root {
    --primary-color: #01be96;
  }
  
  html, body {
    background-color: #000 !important;
    color: #f6f6f9 !important;
    margin: 0;
    padding: 0;
    font-family: 'ABeeZee', sans-serif;
    scroll-behavior: smooth;
  }

  section {
    scroll-margin-top: 90px;
  }

  .container_p {
    max-width: 1355px;
    margin: 0 auto;
    padding: 0 20px;
  }
</style>
