---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// 1. CONFIGURACIÓN DE TU USUARIO DE GITHUB
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  if (response.ok) {
    const data = await response.json();
    proyectos = data
      .filter(repo => !repo.name.includes('github.io'))
      .slice(0, 6)
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Análisis de datos, visualización y estrategia de negocio.",
        lang: repo.language || "Data Science"
      }));
  } else {
    throw new Error("No se pudo conectar con la API");
  }
} catch (e) {
  error = "Modo Offline: Cargando proyectos destacados.";
  proyectos = [
    { 
      name: "Sakila Cinema Analytics", 
      url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
      desc: "Análisis exhaustivo de bases de datos SQL para la optimización de inventario y comportamiento de clientes.", 
      lang: "SQL" 
    },
    { 
      name: "Retail KPI Dashboard", 
      url: "#", 
      desc: "Visualización estratégica de métricas de venta y rotación de stock.", 
      lang: "Power BI" 
    }
  ];
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="Nieves Pérez Alonso - Data Analyst & Retail Specialist. Transformando datos en decisiones estratégicas." />
  
  <!-- Kit de FontAwesome y Google Fonts -->
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous" is:inline></script>
  <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  
  <title>Nieves Pérez Alonso | Portafolio Data Analyst</title>

  <style>
    :root {
      --primary: #0f705d;
      --bg-dark: #020502;
      --text-main: #ffffff;
      --text-dim: #d1d1d1;
      --font-mono: 'Inconsolata', monospace;
    }

    /* Reseteo para asegurar que el diseño no se desconfigure */
    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      font-family: 'Lato', sans-serif;
      overflow-x: hidden;
    }

    .main-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Ajuste para que el contenido no quede debajo del Header fijo */
    section {
      padding: 100px 0 60px 0;
      scroll-margin-top: 100px;
    }

    .hero-flex {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 85vh;
      flex-wrap: wrap;
      gap: 60px;
    }

    .hero-text {
      flex: 1;
      min-width: 320px;
    }

    .typewriter {
      font-family: var(--font-mono);
      color: var(--primary);
      font-weight: 700;
      font-size: 1.2rem;
      margin-bottom: 10px;
    }

    .hero-title {
      font-size: clamp(2.5rem, 6vw, 4rem);
      line-height: 1.1;
      font-weight: 800;
      text-transform: uppercase;
      margin-bottom: 25px;
    }

    /* Estilo de las Cápsulas de Habilidades */
    .skills-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 20px;
    }

    .skill-card {
      background: rgba(15, 112, 93, 0.05);
      border: 1px solid rgba(15, 112, 93, 0.1);
      padding: 25px;
      border-radius: 12px;
      text-align: center;
      transition: 0.3s;
    }

    .skill-card:hover {
      border-color: var(--primary);
      transform: translateY(-5px);
      box-shadow: 0 0 20px rgba(15, 112, 93, 0.2);
    }

    .skill-card i {
      font-size: 2rem;
      color: var(--primary);
      margin-bottom: 10px;
      display: block;
    }

    /* Estilo de Proyectos */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 30px;
    }

    .project-item {
      background: #080808;
      border: 1px solid #1a1a1a;
      padding: 30px;
      border-radius: 8px;
      height: 100%;
      display: flex;
      flex-direction: column;
      transition: 0.3s;
    }

    .project-item:hover {
      border-color: var(--primary);
    }

    /* Imagen de perfil con Halo */
    .profile-container {
      position: relative;
      width: 350px;
      height: 350px;
    }

    .profile-image {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--primary);
      position: relative;
      z-index: 2;
    }

    .profile-halo {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: var(--primary);
      filter: blur(40px);
      opacity: 0.2;
      border-radius: 50%;
      z-index: 1;
    }

    @media (max-width: 768px) {
      .hero-flex {
        flex-direction: column-reverse;
        text-align: center;
      }
      .profile-container {
        width: 280px;
        height: 280px;
      }
    }
  </style>
</head>
<body>

  <Header />

  <main class="main-content">
    
    <!-- SECCIÓN HERO -->
    <section id="inicio" class="hero-flex">
      <div class="hero-text">
        <p class="typewriter">&gt; NIEVES PÉREZ ALONSO</p>
        <h1 class="hero-title">Data Analyst <br/> & Retail Specialist</h1>
        <p style="color: var(--text-dim); font-size: 1.2rem; margin-bottom: 40px; max-width: 600px;">
          Especializada en transformar datos de Retail en decisiones accionables. 
          Más de 6 años optimizando procesos y maximizando rentabilidad mediante el dato.
        </p>
        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background: var(--primary); color: white; padding: 15px 35px; text-decoration: none; font-weight: 700; border-radius: 4px;">Hablemos</a>
          <a href="#proyectos" style="border: 2px solid var(--primary); color: white; padding: 15px 35px; text-decoration: none; font-weight: 700; border-radius: 4px;">Ver Proyectos</a>
        </div>
      </div>

      <div class="profile-container">
        <div class="profile-halo"></div>
        <img src="/img/tu-foto.webp" alt="Nieves Pérez" class="profile-image" onerror="this.src='https://via.placeholder.com/350x350/020502/0f705d?text=NPA'"/>
      </div>
    </section>

    <!-- SECCIÓN PROYECTOS -->
    <section id="proyectos">
      <h2 style="font-family: var(--font-mono); color: var(--primary); margin-bottom: 50px; text-transform: uppercase; font-size: 1.5rem;">
        // Proyectos_Seleccionados
      </h2>
      <div class="projects-grid">
        {proyectos.map(p => (
          <div class="project-item">
            <div style="display: flex; justify-content: space-between; margin-bottom: 25px; color: var(--primary);">
              <i class="fa-regular fa-folder-open" style="font-size: 1.8rem;"></i>
              <a href={p.url} target="_blank" style="color: white; opacity: 0.5; font-size: 1.4rem;"><i class="fa-brands fa-github"></i></a>
            </div>
            <h3 style="margin-bottom: 15px; font-family: var(--font-mono);">{p.name}</h3>
            <p style="color: var(--text-dim); font-size: 0.95rem; flex-grow: 1; margin-bottom: 20px;">{p.desc}</p>
            <div style="color: var(--primary); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700;">
              # {p.lang}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN HABILIDADES -->
    <section id="habilidades">
      <h2 style="font-family: var(--font-mono); color: var(--primary); margin-bottom: 50px; text-transform: uppercase; font-size: 1.5rem;">
        // Stack_Tecnológico
      </h2>
      <div class="skills-container">
        {[
          { name: "Python", icon: "fa-brands fa-python" },
          { name: "MySQL", icon: "fa-solid fa-database" },
          { name: "Tableau", icon: "fa-solid fa-chart-pie" },
          { name: "Power BI", icon: "fa-solid fa-chart-column" },
          { name: "Pandas", icon: "fa-solid fa-table" },
          { name: "Excel", icon: "fa-regular fa-file-excel" }
        ].map(skill => (
          <div class="skill-card">
            <i class={skill.icon}></i>
            <span style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700;">{skill.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN FORMACIÓN -->
    <section id="estudios">
      <h2 style="font-family: var(--font-mono); color: var(--primary); margin-bottom: 50px; text-transform: uppercase; font-size: 1.5rem;">
        // Formación
      </h2>
      <div style="display: flex; flex-direction: column; gap: 30px;">
        <div style="border-left: 3px solid var(--primary); padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.3rem;">Bootcamp Data Analytics & IA</h3>
          <p style="margin: 5px 0; color: var(--primary); font-weight: 700;">Adalab // 2024 - 2025</p>
        </div>
        <div style="border-left: 3px solid #333; padding-left: 25px;">
          <h3 style="margin: 0; font-size: 1.3rem;">Máster en Educación Artística</h3>
          <p style="margin: 5px 0; color: #888;">UCM Madrid</p>
        </div>
      </div>
    </section>

  </main>

  <Footer />

</body>
</html>
