---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "../style/index.css";

// 1. CONFIGURACIÓN DE TU USUARIO DE GITHUB
const GITHUB_USERNAME = "NievesPerez-Data";

let proyectos = [];
let error = null;

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=10`);
  if (response.ok) {
    const data = await response.json();
    proyectos = data
      .filter(repo => !repo.name.includes('github.io'))
      .slice(0, 6)
      .map(repo => ({
        name: repo.name.replace(/-/g, ' ').replace(/_/g, ' '),
        url: repo.html_url,
        desc: repo.description || "Proyecto de análisis de datos y estrategia.",
        lang: repo.language || "Data"
      }));
  } else {
    throw new Error("Error API");
  }
} catch (e) {
  proyectos = [{ 
    name: "Sakila Cinema Analytics", 
    url: "https://github.com/NievesPerez-Data/proyecto-sql-sakila-analysis", 
    desc: "Análisis de bases de datos SQL para optimizar inventario.", 
    lang: "SQL" 
  }];
}
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nieves Pérez Alonso | Data Analyst</title>
  <script src="https://kit.fontawesome.com/2898a0ac51.js" crossorigin="anonymous"></script>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Inconsolata:wght@400;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  
  <style is:global>
    /* RESET DE NAVEGACIÓN - Esto arregla los puntos y el vertical */
    nav ul, header ul, footer ul {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: flex !important;
      gap: 30px !important;
      justify-content: flex-end !important;
    }

    nav li a, header li a, footer li a {
      text-decoration: none !important;
      color: #0f705d !important;
      font-family: 'Inconsolata', monospace !important;
      font-weight: bold !important;
      text-transform: uppercase !important;
      font-size: 0.9rem !important;
      transition: color 0.3s !important;
    }

    nav li a:hover {
      color: #ffffff !important;
    }

    /* Ajuste para el Header fijo */
    header, nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      background: rgba(2, 5, 2, 0.95);
      backdrop-filter: blur(10px);
      z-index: 1000;
      padding: 20px 0;
    }

    .header-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .text-justified {
      text-align: justify;
      hyphens: auto;
    }

    .typewriter-font {
      font-family: 'Courier Prime', 'Courier New', Courier, monospace;
    }

    /* Arreglo para el Footer */
    footer {
      padding: 60px 0;
      border-top: 1px solid rgba(15, 112, 93, 0.2);
      text-align: center;
      margin-top: 100px;
    }
  </style>
</head>
<body style="background-color: #020502; color: #ffffff; margin: 0; font-family: 'Lato', sans-serif;">
  
  <!-- Contenedor del Header -->
  <header>
    <div class="header-container">
      <div style="font-family: 'Courier Prime'; font-weight: bold; color: #0f705d;">PORTFOLIO</div>
      <Header />
    </div>
  </header>

  <main style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    
    <section id="inicio" style="display: flex; align-items: center; justify-content: space-between; padding: 180px 0 80px 0; min-height: 80vh; flex-wrap: wrap; gap: 40px;">
      <div style="flex: 1; min-width: 320px;">
        <p style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.8rem; font-weight: 700; margin-bottom: 10px;">Nieves Pérez Alonso</p>
        <h1 class="typewriter-font" style="font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin: 0 0 25px 0; font-weight: 800; text-transform: uppercase;">DATA ANALYST <br/> & BUSINESS INTELLIGENCE</h1>
        <p class="text-justified" style="color: #d1d1d1; line-height: 1.6; margin-bottom: 40px; max-width: 580px; font-size: 1.1rem;">
          Especializada en transformar datos complejos en decisiones estratégicas. Más de 6 años optimizando procesos y operaciones para maximizar la rentabilidad mediante el análisis avanzado.
        </p>
        <div id="contacto" style="display: flex; gap: 20px; margin-bottom: 40px; scroll-margin-top: 120px;">
          <a href="mailto:nievesperezalonso@gmail.com" style="background-color: #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px; border: 2px solid #0f705d;">Hablemos</a>
          <a href="#" style="border: 2px solid #0f705d; color: #ffffff; padding: 14px 35px; text-decoration: none; font-weight: 700; border-radius: 4px;">Currículum</a>
        </div>
      </div>
      <div style="width: 350px; height: 350px; border-radius: 50%; border: 3px solid #0f705d; overflow: hidden; position: relative; box-shadow: 0 0 30px rgba(15, 112, 93, 0.4);">
        <img src="/img/tu-foto.webp" alt="Nieves Pérez" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://via.placeholder.com/350x350/020502/0f705d?text=NPA'"/>
      </div>
    </section>

    <!-- PROYECTOS -->
    <section id="proyectos" style="padding: 100px 0;">
      <h2 style="color: #0f705d; font-family: 'Inconsolata', monospace; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 50px; display: flex; align-items: center; gap: 15px;">
        Proyectos <span style="height: 1px; background: rgba(15, 112, 93, 0.3); flex-grow: 1;"></span>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
        {proyectos.map(p => (
          <div style="background: rgba(15, 112, 93, 0.05); border: 1px solid rgba(15, 112, 93, 0.2); padding: 30px; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 20px; color: #0f705d;">
                <i class="fa-regular fa-folder" style="font-size: 1.5rem;"></i>
                <a href={p.url} target="_blank" style="color: #ffffff; opacity: 0.7;"><i class="fa-brands fa-github"></i></a>
              </div>
              <h3 class="typewriter-font" style="color: #ffffff; margin-bottom: 10px;">{p.name}</h3>
              <p class="text-justified" style="color: #aaaaaa; font-size: 0.9rem;">{p.desc}</p>
            </div>
            <span style="color: #0f705d; font-family: 'Inconsolata', monospace; font-weight: bold; font-size: 0.8rem; margin-top: 15px;">{p.lang}</span>
          </div>
        ))}
